GAME_TYPE TANKS
GAME_GRID (20, 20)
INITIAL_SPEED 180

# --- DEFINICION DEL JUGADOR ---
# Tanque ágil de 1x1. Mantiene sus puntos de resistencia.
DEFINE SHAPE PLAYER_TANK TYPE: PLAYER COLOR #00FF00 HP 3
STATE 1 [
    [1]
]
END

# --- DEFINICION DE ENEMIGOS ---
# Enemigos de 1x1 para moverse libremente por el mapa.
DEFINE SHAPE BASIC_ENEMY TYPE: ENEMY COLOR #FF0000 HP 1 SPEED 1
STATE 1 [
    [1]
]
END

DEFINE SHAPE ARMORED_ENEMY TYPE: ENEMY COLOR #FFA500 HP 2 SPEED 1
STATE 1 [
    [1]
]
END

# --- DEFINICION DE PROYECTILES ---
# La bala también es de 1x1.
DEFINE SHAPE BULLET TYPE: BULLET COLOR #FFFF00
STATE 1 [
    [1]
]
END

# --- DEFINICION DE POWER-UPS (MARTILLITO) ---
# Ítem de curación de 1x1.
DEFINE SHAPE REPAIR_HAMMER TYPE: POWERUP COLOR #00FFFF HEALS 1
STATE 1 [
    [1]
]
END

# --- DEFINICION DEL JEFE FINAL ---
# Entidad de gran tamaño (3x3) exclusiva para el "Final Boss".
DEFINE BOSS MEGA_FORTRESS COLOR #FF00FF HP 15
STATE 1 [
    [1, 1, 1],
    [1, 0, 1],
    [1, 1, 1]
]
END

# --- LOGICA Y EVENTOS ---
# El compilador buscará 'ON' y no requiere 'EVENTS {}'.
# Se debe usar 'END' al finalizar las acciones de cada evento.

ON START: SPAWN PLAYER_TANK AT (10, 18) END

ON KEY_UP: MOVE PLAYER_TANK UP END
ON KEY_DOWN: MOVE PLAYER_TANK DOWN END
ON KEY_LEFT: MOVE PLAYER_TANK LEFT END
ON KEY_RIGHT: MOVE PLAYER_TANK RIGHT END

ON KEY_SPACE: SHOOT PLAYER_TANK END

ON TARGET_SCORE 1000: SPAWN MEGA_FORTRESS AT (10, 2) END

ON TICK: MOVE BULLET FORWARD END