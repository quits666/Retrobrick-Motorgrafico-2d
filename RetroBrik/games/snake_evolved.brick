# Eventos y Reglas
ON START:
  SPAWN PLAYER AT (10, 10)
  SPAWN FOOD
  SPAWN POISON_FRUIT
  SPAWN POWERUP
END

ON TICK:
  MOVE SNAKE FORWARD
END

ON EAT_FOOD:
  GROW SNAKE
  INCREASE_SCORE 10
  INCREASE_SPEED
  SPAWN FOOD
END

ON EAT_POISON:
  SPAWN POISON_FRUIT
END

ON ACTIVATE_POWERUP:
  SPAWN POWERUP
END

ON LEVEL_UP:
  NEXT_LEVEL
  RESET_SNAKE
END

# Controles
ON KEY_LEFT:
  CHANGE_DIRECTION LEFT
END
ON KEY_RIGHT:
  CHANGE_DIRECTION RIGHT
END
ON KEY_UP:
  CHANGE_DIRECTION UP
END
ON KEY_DOWN:
  CHANGE_DIRECTION DOWN
END