GAME_TYPE SNAKE
GAME_GRID (20, 20)

INITIAL_SPEED 300
SPEED_INCREMENT 5

# Personalización Geométrica (CIRCULAR, TRIANGULAR o RECTANGLE)
DEFINE SHAPE CIRCULAR

# Bloque de Niveles de Dificultad
LEVELS {
  LEVEL BABY:
    HAS_POISON_FRUIT FALSE
    HAS_OBSTACLES FALSE
    SPEED 300

  LEVEL ENTUSIASTA:
    HAS_POISON_FRUIT TRUE
    INVULNERABILITY_TIME 6 SECONDS
    SPEED 250

  LEVEL NYAN_CAT:
    HAS_OBSTACLES TRUE
    SPEED 200
}

# Configuración de Mapa/Progreso
